                  "scalars, and will raise a `TypeError` in a future release. "
                  "Use `np.round` or `scalar.round` instead.") < 0) {
        return NULL;
    }
#endif

    PyObject *tup;
    if (ndigits == Py_None) {
        tup = PyTuple_Pack(0);
    }
    else {
