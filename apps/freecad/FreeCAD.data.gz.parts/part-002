/*==========================================================
 * Constants
 *=========================================================*/
#if defined(_MSC_VER) && !defined(__INTEL_COMPILER)
static const @ctype@ c_1@c@ = {1.0@C@, 0.0@C@};
#else
static const @ctype@ c_1@c@ = 1.0@C@;
