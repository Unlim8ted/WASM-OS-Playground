            STILL, INTERACTIVE = list(range(2))
            BUFFER_SINGLE, BUFFER_DOUBLE, BUFFER_INTERACTIVE = list(range(3))
            VARIABLE_NEAR_PLANE, CONSTANT_NEAR_PLANE = list(range(2))

        class SoGui_Quarter_Wrapper(object):
