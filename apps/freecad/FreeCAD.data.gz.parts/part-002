    npy_clear_floatstatus_barrier((char*)&arg1);
#endif

    if (is_forward) {
        arg1 = PyArrayScalar_VAL(a, @Name@);
        arg2 = other_val;
    }
    else {
        arg1 = other_val;
        arg2 = PyArrayScalar_VAL(b, @Name@);
    }

    /*
     * Prepare the actual calculation:
     */
    @type@ out;

    /*
     * here we do the actual calculation with arg1 and arg2
     * as a function call.
