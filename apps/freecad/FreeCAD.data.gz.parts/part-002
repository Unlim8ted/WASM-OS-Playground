  include(CheckCSourceCompiles)
  check_c_source_compiles("
  #if __riscv_xlen == 64
  int main() { return 0; }
  #else
  #error Not RISCV-64
  #endif
  " IS_RISCV_XLEN_64)

  check_c_source_compiles("
  #if __riscv_xlen == 32
  int main() { return 0; }
  #else
  #error Not RISCV-32
  #endif
  " IS_RISCV_XLEN_32)

  if(IS_RISCV_XLEN_32)
    set(RISCV_XLEN 32)
